# Auth0 web application settings. Get these from the Auth0 Dashboard.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=replace-with-32-random-bytes-as-64-hex-characters
APP_BASE_URL=http://localhost:3000
AUTH0_OWNER_ID=auth0|your-owner-user-id

# Supabase project API settings. Keep the secret key server-only.
# Run supabase/schema.sql to create the database and public recipe-photos bucket.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Older Supabase projects can use their server-side service_role key instead.
# SUPABASE_SERVICE_ROLE_KEY=
